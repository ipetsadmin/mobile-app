{
  "expo": {
    "name": "Truffa",
    "slug": "truffa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "truffa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.truffa.app"
    },
    "android": {
      "package": "com.truffa.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C4CED8"
        }
      ],
      "expo-localization",
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/geom/400Regular/Geom_400Regular.ttf",
            "node_modules/@expo-google-fonts/geom/500Medium/Geom_500Medium.ttf",
            "node_modules/@expo-google-fonts/geom/600SemiBold/Geom_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/geom/700Bold/Geom_700Bold.ttf",
            "node_modules/@expo-google-fonts/iosevka-charon/400Regular/IosevkaCharon_400Regular.ttf",
            "node_modules/@expo-google-fonts/iosevka-charon/500Medium/IosevkaCharon_500Medium.ttf",
            "node_modules/@expo-google-fonts/playwrite-nz-basic/400Regular/PlaywriteNZBasic_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Truffa uses your photos so you can add a picture of your companion.",
          "cameraPermission": "Truffa uses your camera so you can take a picture of your companion.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c53f0c7-cbda-4555-bf42-d998cfe9649e"
      }
    },
    "owner": "truffa"
  }
}
