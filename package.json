  "dependencies": {
    "@better-auth/expo": "^1.7.12",
    "@expo-google-fonts/geom": "^0.4.0",
    "@expo-google-fonts/iosevka-charon": "^0.4.0",
    "@expo-google-fonts/playwrite-nz-basic": "^0.4.0",
    "@expo/ui": "~57.0.23",
    "@hookform/resolvers": "^5.9.1",
    "@ipetsadmin/api-client": "^1.12.0",
    "@ipetsadmin/contracts": "^1.13.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.12",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "biome:format": "biome format --write ./src",
    "biome:check": "biome check --write ./src",
    "biome:lint": "biome lint --write ./src"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/src/test/global-setup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/constants/**",
      "!src/test/**",
      "!src/**/*.test.{ts,tsx}"
    ],
    "clearMocks": true
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "biome check --write --no-errors-on-unmatched"
  }
}
